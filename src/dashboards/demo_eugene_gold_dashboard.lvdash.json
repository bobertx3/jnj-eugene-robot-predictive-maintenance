          "position": {
            "x": 3,
            "y": 5,
            "width": 3,
            "height": 5
          }
        },
        {
          "widget": {
            "name": "service_queue_table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "service_queue_ds",
                  "fields": [
                    {
                      "name": "event_date",
                      "expression": "`event_date`"
                    },
                    {
                      "name": "robot_id",
                      "expression": "`robot_id`"
                    },
                    {
                      "name": "component_id",
                      "expression": "`component_id`"
                    },
                    {
                      "name": "component_type",
                      "expression": "`component_type`"
                    },
                    {
                      "name": "site_name",
                      "expression": "`site_name`"
                    },
                    {
                      "name": "error_events",
                      "expression": "`error_events`"
                    },
                    {
                      "name": "maintenance_risk_score",
                      "expression": "`maintenance_risk_score`"
                    },
                    {
                      "name": "risk_ml_probability",
                      "expression": "`risk_ml_probability`"
                    },
                    {
